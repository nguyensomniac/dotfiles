#!/bin/bash
set -u

dcg="$HOME/.local/bin/dcg"
payload="$(mktemp)"
stderr_file="$(mktemp)"
trap 'rm -f "$payload" "$stderr_file"' EXIT

cat > "$payload"

if [ ! -x "$dcg" ]; then
  echo "dcg is not installed at $dcg; allowing command" >&2
  exit 0
fi

"$dcg" < "$payload" 2> "$stderr_file"
rc=$?

if [ "$rc" -eq 0 ]; then
  exit 0
fi

cat "$stderr_file" >&2

if grep -q "BLOCKED: Destructive Command Detected" "$stderr_file"; then
  printf '%s\n' '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"deny","permissionDecisionReason":"Destructive command blocked by dcg."}}'
fi

exit 0

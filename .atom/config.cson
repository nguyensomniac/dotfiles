"*":
  "base16-syntax":
    scheme: "Ocean"
  core:
    disabledPackages: [
      "power-mode"
      "rainbow"
    ]
    telemetryConsent: "no"
    themes: [
      "spacegray-light-neue-ui"
      "base16-syntax"
    ]
  editor:
    fontFamily: "Input Mono"
    fontSize: 11
    lineHeight: 1.6
    tabType: "soft"
  "exception-reporting":
    userId: "67773382-ca53-afd5-032f-6892db9c21cc"
  rainbow:
    cycleDuration: 30000
  "tree-view":
    hideVcsIgnoredFiles: true
  welcome:
    showOnStartup: false

"*":
  "activate-power-mode":
    plugins:
      playAudio: true
      screenShake: true
  "base16-syntax":
    scheme: "Atelier Dune"
  core:
    disabledPackages: [
      "power-mode"
      "activate-power-mode"
      "rainbow"
      "city-lights-icons"
    ]
    excludeVcsIgnoredPaths: false
    telemetryConsent: "no"
    themes: [
      "spacegray-eighties-ui"
      "uber-base-dark-syntax"
    ]
  editor:
    fontFamily: "Source Code pro"
    lineHeight: 1.714
  "exception-reporting":
    userId: "67773382-ca53-afd5-032f-6892db9c21cc"
  "markdown-preview":
    useGitHubStyle: true
  "prettier-atom":
    formatOnSaveOptions: {}
  rainbow:
    cycleDuration: 30000
  "tree-view":
    hideVcsIgnoredFiles: true
  welcome:
    showOnStartup: false
